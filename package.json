{
  "name": "investing-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prices": "node scripts/fetch-prices.mjs",
    "dev": "astro dev",
    "build": "node scripts/fetch-prices.mjs && node --env-file-if-exists=.env scripts/fetch-insiders.mjs && node --env-file-if-exists=.env scripts/fetch-sentiment.mjs && astro build",
    "build:offline": "astro build",
    "preview": "astro preview",
    "insiders": "node --env-file-if-exists=.env scripts/fetch-insiders.mjs",
    "sentiment": "node --env-file-if-exists=.env scripts/fetch-sentiment.mjs",
    "sentiment:claude": "SENTIMENT_MODE=claude node --env-file-if-exists=.env scripts/fetch-sentiment.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "astro": "^7.3.8"
  }
}
